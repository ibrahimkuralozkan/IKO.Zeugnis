@* Bewertungsansicht für Lehrkraft und Verwaltung. Touch-optimiert: große Schaltflächen, erneutes Tippen hebt auf. *@
@inject IJSRuntime JS

@if (Context.Students.Count == 0)
{
    <div class="card"><p class="muted">Keine Schüler.</p></div>
}
else
{
    var total = Context.TotalProgress();
    <div class="grading">
        <aside class="student-list card" aria-label="Schüler">
            <div class="list-head">
                <strong>@Context.Students.Count Schüler</strong>
                <span class="muted">@Percent(total) %</span>
            </div>
            <div class="progress-bar" role="progressbar" aria-valuenow="@Percent(total)" aria-valuemin="0" aria-valuemax="100">
                <span style="width:@(Percent(total))%"></span>
            </div>
            <label class="check small-check">
                <input type="checkbox" checked="@_onlyOpen" @onchange="ToggleOnlyOpen" />
                <span>nur unvollständige</span>
            </label>
            <ul>
                @foreach (var s in VisibleStudents)
                {
                    var p = Context.ProgressOf(s);
                    <li>
                        <button class="student @(s == Current ? "active" : "") @(p.IsComplete ? "done" : "")"
                                @onclick="() => Select(s)" aria-current="@(s == Current ? "true" : null)">
                            <span class="name">@s.LastName, @s.FirstName@if (MultipleClasses) {<span class="muted small"> · @s.ClassName</span>}</span>
                            <span class="count">@(p.IsComplete ? "✓" : $"{p.Filled}/{p.Total}")</span>
                        </button>
                    </li>
                }
            </ul>
        </aside>

        @if (Current is { } summaryStudent)
        {
            var summaryProgress = Context.ProgressOf(summaryStudent);
            var summaryFields = Context.FieldStatusesFor(summaryStudent);
            <aside class="evaluation-summary card" aria-label="Bewertungsfortschritt">
                <div class="evaluation-metrics">
                    <div class="evaluation-metric total"><span>Zu bewerten</span><strong>@summaryProgress.Total</strong></div>
                    <button class="evaluation-metric open @(_fieldList == "open" ? "active" : "")" type="button"
                            disabled="@(summaryProgress.Total - summaryProgress.Filled == 0)" @onclick="ToggleOpenFieldList">
                        <span>Offen</span><strong>@(summaryProgress.Total - summaryProgress.Filled)</strong><span aria-hidden="true">▾</span>
                    </button>
                    <button class="evaluation-metric done @(_fieldList == "done" ? "active" : "")" type="button"
                            disabled="@(summaryProgress.Filled == 0)" @onclick="ToggleDoneFieldList">
                        <span>Bewertet</span><strong>@summaryProgress.Filled</strong><span aria-hidden="true">▾</span>
                    </button>
                </div>
                @if (_fieldList is { } listKind)
                {
                    var showFilled = listKind == "done";
                    var listed = summaryFields.Where(f => f.IsFilled == showFilled).ToList();
                    <div class="evaluation-popover">
                        <h3>@(showFilled ? $"Bereits bewertete Felder ({listed.Count})" : $"Noch offene Felder ({listed.Count})")</h3>
                        <div class="evaluation-field-list">
                            @foreach (var field in listed)
                            {
                                <button class="evaluation-field @(showFilled ? "done" : "open")" type="button"
                                        @onclick="() => JumpToField(summaryStudent, field.Key)">@field.Label</button>
                            }
                        </div>
                    </div>
                }
            </aside>
        }

        <div class="grading-main report-view">
            @if (Current is { } st)
            {
                var index = IndexOf(st);
                var p = Context.ProgressOf(st);
                var sections = Context.SectionsFor(st);
                <div class="student-head card">
                    <button class="btn nav" @onclick="() => Step(-1)" disabled="@(index == 0)" aria-label="vorheriger Schüler">‹</button>
                    <div class="who">
                        <h2>@st.FirstName @st.LastName</h2>
                        <p class="muted">
                            @st.ClassName · @Labels.Of(st.Track) · @(index + 1) von @NavigationStudents.Count ·
                            <span class="@(p.IsComplete ? "ok-text" : "")">@p.Filled/@p.Total ausgefüllt</span>
                        </p>
                    </div>
                    <button class="btn nav" @onclick="() => Step(1)" disabled="@(index == NavigationStudents.Count - 1)" aria-label="nächster Schüler">›</button>
                </div>

                <header class="report-preview-head">
                    <p class="report-school">@(string.IsNullOrWhiteSpace(SchoolName) ? "Schule" : SchoolName)</p>
                    <h1>Zeugnis</h1>
                    <p>für</p>
                    <h2>@st.FirstName @st.LastName</h2>
                    <div class="report-meta">
                        <span><strong>Klasse</strong> @st.ClassName</span>
                        <span><strong>Zeitraum</strong> @Context.Term</span>
                    </div>
                    <p class="muted small report-hint">Interaktive Arbeitsansicht · Die Word-Ausgabe verwendet die hinterlegte Schulvorlage.</p>
                </header>

                @if (Context.CatalogFor(st) is null)
                {
                    <p class="alert warn">Für Klasse @st.ClassName (@Labels.Of(st.Track)) gibt es keinen Katalog.</p>
                }
                else if (sections.Count == 0)
                {
                    <p class="alert info">Für diesen Schüler sind keine Bereiche freigegeben.</p>
                }

                @foreach (var g in sections)
                {
                    var scale = Context.CatalogFor(st)!.RatingScale;
                    var incompleteElement = g.Section.Kind != FieldKind.Rating && g.Keys.Any(key => Context.Get(st, key).Length == 0);
                    <section id="@(g.Section.Kind == FieldKind.Rating ? null : FieldAnchor(st, g.Keys[0]))"
                             class="card grade-section @(incompleteElement ? "incomplete-element" : "")"
                             @key="@($"{st.Id}|{g.Section.Kind}|{g.Section.Key}")">
                        <h3>@g.Section.Title</h3>
                        @if (Context.AuthorsOf(st, g.Keys) is { Count: > 0 } authors)
                        {
                            <p class="muted small author">eingetragen von @string.Join(", ", authors)</p>
                        }
                        @switch (g.Section.Kind)
                        {
                            case FieldKind.Rating:
                                <div class="rating-table" style="--steps:@scale.Count">
                                    <div class="rating-head" aria-hidden="true">
                                        <span></span>
                                        @foreach (var label in scale)
                                        {
                                            <span>@label</span>
                                        }
                                    </div>
                                    @for (var i = 0; i < g.Items.Count; i++)
                                    {
                                        var item = g.Items[i];
                                        var key = g.Keys[i];
                                        var value = Context.Get(st, key);
                                        <div id="@FieldAnchor(st, key)" class="rating-row @(value.Length == 0 ? "empty" : "")" role="radiogroup" aria-label="@item.Text">
                                            <span class="criterion">@item.Text</span>
                                            @for (var n = 1; n <= scale.Count; n++)
                                            {
                                                var v = n.ToString();
                                                <button class="choice @(value == v ? "on" : "")" role="radio" aria-checked="@(value == v ? "true" : "false")"
                                                        title="@scale[n - 1]" @onclick="() => Toggle(st, key, v)">
                                                    <span class="mark">@(value == v ? "✕" : "")</span>
                                                    <span class="lbl">@scale[n - 1]</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                break;

                            case FieldKind.Grade:
                                var grade = Context.Get(st, g.Keys[0]);
                                <div class="grade-options" role="radiogroup" aria-label="Note @g.Section.Title">
                                    @for (var n = 1; n <= 6; n++)
                                    {
                                        var v = n.ToString();
                                        <div class="grade-option">
                                            <span>@GradeWord(v)</span>
                                            <button class="chip @(grade == v ? "on" : "")" role="radio" aria-checked="@(grade == v ? "true" : "false")"
                                                    title="@($"{v} – {GradeWord(v)}")" @onclick="() => Toggle(st, g.Keys[0], v)">@v</button>
                                        </div>
                                    }
                                </div>
                                break;

                            case FieldKind.Selection:
                                var sel = Context.Get(st, g.Keys[0]);
                                <div class="chips wrap" role="radiogroup" aria-label="@g.Section.Title">
                                    @foreach (var opt in g.Items)
                                    {
                                        <button class="chip wide @(sel == opt.Id ? "on" : "")" role="radio" aria-checked="@(sel == opt.Id ? "true" : "false")"
                                                @onclick="() => Toggle(st, g.Keys[0], opt.Id)">@ReportText.Fill(opt.Text, st, Context.Term)</button>
                                    }
                                </div>
                                break;

                            case FieldKind.Date:
                                <input type="date" value="@Context.Get(st, g.Keys[0])" aria-label="@g.Section.Title"
                                       @onchange="e => SetText(st, g.Keys[0], e.Value?.ToString() ?? string.Empty)" />
                                break;

                            case FieldKind.Number:
                                var number = Context.Get(st, g.Keys[0]);
                                <input class="number-input" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                                       value="@number" aria-label="@g.Section.Title" placeholder="0"
                                       @oninput="e => SetText(st, g.Keys[0], new string((e.Value?.ToString() ?? string.Empty).Where(char.IsAsciiDigit).Take(4).ToArray()))" />
                                break;

                            default:
                                var text = Context.Get(st, g.Keys[0]);
                                <textarea class="report-text" rows="4" value="@text" aria-label="@g.Section.Title"
                                          @oninput="e => SetText(st, g.Keys[0], e.Value?.ToString() ?? string.Empty)"></textarea>
                                <div class="muted small">@text.Length Zeichen</div>
                                break;
                        }
                    </section>
                }

                <div class="step-footer">
                    <button class="btn" @onclick="() => Step(-1)" disabled="@(index == 0)">‹ Vorheriger</button>
                    <button class="btn primary" @onclick="() => Step(1)" disabled="@(index == NavigationStudents.Count - 1)">Nächster ›</button>
                </div>
            }
            else if (_onlyOpen)
            {
                <div class="card"><p class="ok-text"><strong>Alle Schüler vollständig.</strong></p></div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public GradingContext Context { get; set; } = default!;
    [Parameter] public string SchoolName { get; set; } = string.Empty;
    /// <summary>Wird nach jeder Änderung aufgerufen (Speicherstatus, Entwurf).</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Guid? _currentId;
    private bool _onlyOpen;
    private string? _fieldList;

    private Student? Current
    {
        get
        {
            var students = NavigationStudents;
            var s = students.FirstOrDefault(x => x.Id == _currentId) ?? students.FirstOrDefault();
            _currentId = s?.Id;
            return s;
        }
    }

    private IReadOnlyList<Student> NavigationStudents =>
        _onlyOpen ? Context.IncompleteStudents() : Context.Students;

    private IEnumerable<Student> VisibleStudents => NavigationStudents;

    private int IndexOf(Student s) => NavigationStudents.ToList().IndexOf(s);

    private static int Percent(Progress p) => p.Total == 0 ? 0 : (int)Math.Round(100.0 * p.Filled / p.Total);

    private static string GradeWord(string g) => g switch
    {
        "1" => "sehr gut", "2" => "gut", "3" => "befriedigend", "4" => "ausreichend", "5" => "mangelhaft", "6" => "ungenügend",
        _ => "",
    };

    private async Task Select(Student s)
    {
        _currentId = s.Id;
        _fieldList = null;
        await JS.InvokeVoidAsync("zeugnis.scrollToMain");
    }

    private void ToggleFieldList(string kind) => _fieldList = _fieldList == kind ? null : kind;

    private void ToggleOpenFieldList() => ToggleFieldList("open");

    private void ToggleDoneFieldList() => ToggleFieldList("done");

    private async Task JumpToField(Student student, string key)
    {
        _fieldList = null;
        await JS.InvokeVoidAsync("zeugnis.scrollToField", FieldAnchor(student, key));
    }

    private static string FieldAnchor(Student student, string key) =>
        $"field-{student.Id:N}-{string.Concat(key.Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-'))}";

    private void ToggleOnlyOpen(ChangeEventArgs e)
    {
        _onlyOpen = e.Value is true;
        _fieldList = null;
        var students = NavigationStudents;
        if (students.All(s => s.Id != _currentId)) _currentId = students.FirstOrDefault()?.Id;
    }

    private void Step(int delta)
    {
        if (Current is not { } s) return;
        var list = NavigationStudents;
        if (list.Count == 0) return;
        var i = Math.Clamp(IndexOf(s) + delta, 0, list.Count - 1);
        _currentId = list[i].Id;
        _fieldList = null;
        _ = JS.InvokeVoidAsync("zeugnis.scrollToMain");
    }

    private async Task Toggle(Student s, string key, string value)
    {
        var next = Context.Get(s, key) == value ? "" : value;
        if (Context.Set(s, key, next, DateTimeOffset.UtcNow)) await OnChanged.InvokeAsync();
    }

    private bool MultipleClasses => Context.Students.Select(s => s.ClassName).Distinct().Skip(1).Any();

    private async Task SetText(Student s, string key, string value)
    {
        if (Context.Set(s, key, value, DateTimeOffset.UtcNow)) await OnChanged.InvokeAsync();
    }
}
