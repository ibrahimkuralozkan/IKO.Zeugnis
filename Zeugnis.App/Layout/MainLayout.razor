@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">Z</span>
            <span>Zeugnis</span>
        </a>
        <span class="version">v@(AppInfo.Version)</span>
    </header>
    <div class="frame">
        <nav class="sidebar" aria-label="Bereiche">
            <NavLink class="side-link" href="lehrkraft" Match="NavLinkMatch.Prefix">
                <span class="side-icon" aria-hidden="true">✎</span>
                <span>Lehrkraft</span>
            </NavLink>
            <NavLink class="side-link" href="verwaltung" Match="NavLinkMatch.Prefix">
                <span class="side-icon" aria-hidden="true">⚙</span>
                <span>Verwaltung</span>
            </NavLink>
        </nav>
        <main class="content">
            @Body
        </main>
    </div>
</div>
<div class="banners">
    <IdleGuard />
    <UpdateNotice />
</div>
<UnloadGuard />
