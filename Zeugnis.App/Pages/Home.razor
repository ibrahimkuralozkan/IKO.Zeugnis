@page "/"

<PageTitle>Zeugnis</PageTitle>

<section class="hero">
    <h1>Zeugnisse gemeinsam erstellen</h1>
    <p class="muted">
        Alle Daten bleiben verschlüsselt in Ihren Dateien. Diese App speichert nichts auf einem Server.
    </p>
</section>

<div class="role-grid">
    <a class="card role" href="lehrkraft">
        <span class="role-icon" aria-hidden="true">✎</span>
        <h2>Lehrkraft</h2>
        <p>Arbeitsauftrag (<code>.zauftrag</code>) öffnen, Bewertungen eintragen und Rückgabe erstellen.</p>
    </a>
    <a class="card role" href="verwaltung">
        <span class="role-icon" aria-hidden="true">⚙</span>
        <h2>Verwaltung</h2>
        <p>Schuldatei (<code>.zschule</code>) öffnen, Aufträge verteilen, Rückgaben zusammenführen.</p>
    </a>
</div>
