@page "/verwaltung"
@implements IDisposable
@inject SchoolSession Session
@inject FileService Files

<PageTitle>Verwaltung – Zeugnis</PageTitle>

<h1>Verwaltung</h1>

@if (Session.File is not { } f)
{
    <div class="two-col">
        <OpenFileForm Title="Schuldatei öffnen" Accept=".zschule"
                      Hint="Immer die neueste Revision öffnen (höchste R-Nummer im Dateinamen)."
                      OnOpen="Session.OpenAsync" />

        <form class="card form" @onsubmit="Create" @onsubmit:preventDefault>
            <h2>Neue Schuldatei</h2>
            <p class="muted">Einmal pro Halbjahr. Das Kennwort kann nicht wiederhergestellt werden.</p>
            <label class="field"><span>Schule</span><input @bind="_schoolName" /></label>
            <div class="row">
                <label class="field"><span>Schuljahr</span><input @bind="_schoolYear" placeholder="2026/27" /></label>
                <label class="field">
                    <span>Halbjahr</span>
                    <select @bind="_halfYear"><option value="1">1</option><option value="2">2</option></select>
                </label>
            </div>
            <label class="field"><span>Kennwort (mind. @EnvelopeCodec.MinPasswordLength Zeichen)</span><input type="password" @bind="_password" autocomplete="new-password" /></label>
            <label class="field"><span>Kennwort wiederholen</span><input type="password" @bind="_password2" autocomplete="new-password" /></label>
            @if (_createError is not null)
            {
                <p class="alert error" role="alert">@_createError</p>
            }
            <button class="btn primary" type="submit">Erstellen</button>
        </form>
    </div>
}
else
{
    <div class="card">
        <div class="card-head">
            <div>
                <h2>@f.School.Name</h2>
                <p class="muted">@f.Term · Revision @f.Revision@(Session.IsDirty ? " · ungespeichert" : "")</p>
            </div>
            <div class="actions">
                <button class="btn primary" @onclick="SaveAsync">Speichern (neue Revision)</button>
                <button class="btn" @onclick="Close">Schließen</button>
            </div>
        </div>
        <dl class="facts">
            <div><dt>Klassen</dt><dd>@f.Classes.Count</dd></div>
            <div><dt>Schüler</dt><dd>@f.Students.Count</dd></div>
            <div><dt>Lehrkräfte</dt><dd>@f.Teachers.Count</dd></div>
            <div><dt>Aufträge</dt><dd>@f.Assignments.Count</dd></div>
            <div><dt>Rückgaben</dt><dd>@f.ProcessedResponseIds.Count</dd></div>
        </dl>
        @if (_saved is not null)
        {
            <p class="alert success">Gespeichert als <strong>@_saved</strong>. Diese Datei in LOGINEO ablegen und die ältere Revision dort löschen.</p>
        }
        @if (_confirmClose)
        {
            <p class="alert warn">
                Es gibt ungespeicherte Änderungen.
                <button class="btn danger" @onclick="ForceClose">Trotzdem schließen</button>
                <button class="btn" @onclick="() => _confirmClose = false">Abbrechen</button>
            </p>
        }
        <p class="alert info">Datenimport, Aufträge und Zusammenführen folgen in Version 0.2–0.4.</p>
    </div>

    <details class="card">
        <summary>Protokoll (@f.Audit.Count)</summary>
        <ul class="audit">
            @foreach (var e in f.Audit.AsEnumerable().Reverse())
            {
                <li><time>@e.Utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time> <strong>@e.Action</strong> @e.Detail</li>
            }
        </ul>
    </details>
}

@code {
    private string _schoolName = "";
    private string _schoolYear = "";
    private int _halfYear = 1;
    private string _password = "";
    private string _password2 = "";
    private string? _createError;
    private string? _saved;
    private bool _confirmClose;

    protected override void OnInitialized() => Session.Changed += Refresh;
    public void Dispose() => Session.Changed -= Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);

    private void Create()
    {
        _createError = null;
        if (_password != _password2) { _createError = "Die Kennwörter stimmen nicht überein."; return; }
        try
        {
            Session.CreateNew(new SchoolInfo { Name = _schoolName.Trim() }, new Term(_schoolYear.Trim(), _halfYear), _password);
            _password = _password2 = "";
        }
        catch (ExchangeSecurityException ex) { _createError = ex.Message; }
    }

    private async Task SaveAsync()
    {
        var (bytes, name) = await Session.SaveAsync();
        await Files.DownloadAsync(bytes, name);
        _saved = name;
    }

    private void Close()
    {
        if (Session.IsDirty) { _confirmClose = true; return; }
        ForceClose();
    }

    private void ForceClose()
    {
        _confirmClose = false;
        _saved = null;
        Session.Close();
    }
}
