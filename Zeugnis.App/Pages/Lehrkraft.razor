@page "/lehrkraft"
@implements IDisposable
@inject TeacherSession Session
@inject FileService Files

<PageTitle>Lehrkraft – Zeugnis</PageTitle>

@if (Session.Assignment is not { } a || Session.Grading is not { } ctx)
{
    <h1>Lehrkraft</h1>
    <div class="two-col">
        <OpenFileForm Title="Arbeitsauftrag öffnen" Accept=".an-lehrkraft"
                      Hint="Die Datei erhalten Sie von der Verwaltung, das Kennwort auf einem anderen Weg."
                      OnOpen="Session.OpenAsync" />
        <div class="card">
            <h2>So geht es</h2>
            <ol class="steps">
                <li>Arbeitsauftrag (<code>.an-lehrkraft</code>) aus LOGINEO laden und hier mit dem Kennwort öffnen.</li>
                <li>Bewertungen eintragen. Der Zwischenstand wird verschlüsselt auf diesem Gerät gesichert.</li>
                <li>„Rückgabe erstellen“ und die <code>.an-verwaltung</code>-Datei in LOGINEO ablegen.</li>
            </ol>
            <p class="muted">Korrekturen sind jederzeit möglich: Auftrag erneut öffnen, ändern, neue Rückgabe senden.</p>
        </div>
    </div>
}
else
{
    var total = ctx.TotalProgress();
    <div class="admin-head">
        <div>
            <h1>@a.Label · @(a.ClassNames.Count > 1 ? "Klassen" : "Klasse") @a.ClassName</h1>
            <p class="muted">
                @a.SchoolName · @a.Term · @a.TeacherName · Abgabe bis @a.ExpiresUtc.ToLocalTime().ToString("dd.MM.yyyy")
            </p>
        </div>
        <div class="actions">
            <button class="btn primary" @onclick="CreateResponseAsync" disabled="@_busy">Rückgabe erstellen</button>
            <button class="btn" @onclick="CloseAsync">Schließen</button>
        </div>
    </div>

    <div class="status-line">
        <span>@total.Filled von @total.Total Feldern ausgefüllt</span>
        <span class="draft-state @Session.Draft.ToString().ToLowerInvariant()">@DraftText()</span>
    </div>

    @if (a.ExpiresUtc < DateTimeOffset.UtcNow)
    {
        <p class="alert warn">Die Abgabefrist ist abgelaufen. Eine Rückgabe wird von der Verwaltung nicht mehr angenommen. Bitte neuen Auftrag anfordern.</p>
    }
    @if (_response is not null)
    {
        <div class="alert success">
            Rückgabe <strong>@_response</strong> wurde erstellt (@(_responseProgress.Filled) von @(_responseProgress.Total) Feldern).
            Bitte in LOGINEO ablegen. Das Kennwort bleibt dasselbe wie beim Auftrag.
            @if (!_responseProgress.IsComplete)
            {
                <br /><span>Hinweis: Es sind noch nicht alle Felder ausgefüllt. Sie können später eine weitere Rückgabe senden.</span>
            }
        </div>
    }
    @if (_error is not null)
    {
        <p class="alert error" role="alert">@_error</p>
    }

    <GradingView Context="ctx" SchoolName="@a.SchoolName" SchoolAddressLine1="@a.SchoolAddressLine1"
                 SchoolAddressLine2="@a.SchoolAddressLine2" SchoolPhone="@a.SchoolPhone"
                 SchoolLeftLogoDataUrl="@a.SchoolLeftLogoDataUrl" SchoolRightLogoDataUrl="@a.SchoolRightLogoDataUrl"
                 OnChanged="Session.MarkChanged" />

    <details class="card">
        <summary>Meine Änderungen (@a.TeacherAudit.Count)</summary>
        @if (a.TeacherAudit.Count == 0)
        {
            <p class="muted">Noch keine Änderungen.</p>
        }
        else
        {
            <ul class="audit">
                @foreach (var entry in a.TeacherAudit.AsEnumerable().Reverse())
                {
                    <li>
                        <time>@entry.Utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</time>
                        <strong>@entry.StudentName</strong> · @entry.ClassName · @entry.FieldLabel:
                        @entry.OldDisplay → @entry.NewDisplay
                    </li>
                }
            </ul>
        }
    </details>

    <p class="muted small">
        Zwischenstände werden verschlüsselt in diesem Browser gesichert (nur mit dem Auftragskennwort lesbar)
        und beim nächsten Öffnen desselben Auftrags wiederhergestellt.
    </p>
}

@code {
    private bool _busy;
    private string? _response;
    private Progress _responseProgress;
    private string? _error;

    protected override void OnInitialized() => Session.Changed += Refresh;
    public void Dispose() => Session.Changed -= Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);

    private string DraftText() => Session.Draft switch
    {
        DraftState.Pending => "Wird gesichert …",
        DraftState.Saved => $"Gesichert {Session.DraftSavedUtc?.ToLocalTime():HH:mm}",
        DraftState.Failed => "Sicherung fehlgeschlagen – bitte Rückgabe erstellen",
        _ => "",
    };

    private async Task CreateResponseAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _responseProgress = Session.Grading!.TotalProgress();
            var (bytes, name) = await Session.CreateResponseAsync();
            await Files.DownloadAsync(bytes, name);
            _response = name;
        }
        catch (ExchangeSecurityException ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task CloseAsync()
    {
        await Session.CloseAsync();
        _response = null;
    }
}
