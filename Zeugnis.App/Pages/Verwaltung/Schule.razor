@page "/verwaltung/schule"
@inherits AdminPageBase

<PageTitle>Schule – Verwaltung</PageTitle>

<AdminFrame Error="@Error" Success="@Success">
    @if (File is { } f)
    {
        <form class="card form narrow" @onsubmit="Save" @onsubmit:preventDefault>
            <h2>Schule</h2>
            <p class="muted">Diese Angaben erscheinen im Zeugniskopf.</p>
            <label class="field"><span>Name der Schule</span><input @bind="_info.Name" /></label>
            <label class="field"><span>Anschrift, Zeile 1</span><input @bind="_info.AddressLine1" placeholder="Straße Nr." /></label>
            <label class="field"><span>Anschrift, Zeile 2</span><input @bind="_info.AddressLine2" placeholder="PLZ Ort" /></label>
            <div class="row">
                <label class="field"><span>Ort (für „Ort, Datum“)</span><input @bind="_info.Town" /></label>
                <label class="field"><span>Telefon</span><input @bind="_info.Phone" type="tel" /></label>
            </div>
            <div class="school-logo-grid">
                <div class="school-logo-field">
                    <strong>Logo links</strong>
                    @if (_info.LeftLogoDataUrl.Length > 0) {<img src="@_info.LeftLogoDataUrl" alt="Logo links" />}
                    <InputFile OnChange="e => SetLogoAsync(e, true)" accept="image/png,image/jpeg,image/webp" />
                    @if (_info.LeftLogoDataUrl.Length > 0) {<button class="btn" type="button" @onclick="() => RemoveLogo(true)">Entfernen</button>}
                </div>
                <div class="school-logo-field">
                    <strong>Logo rechts</strong>
                    @if (_info.RightLogoDataUrl.Length > 0) {<img src="@_info.RightLogoDataUrl" alt="Logo rechts" />}
                    <InputFile OnChange="e => SetLogoAsync(e, false)" accept="image/png,image/jpeg,image/webp" />
                    @if (_info.RightLogoDataUrl.Length > 0) {<button class="btn" type="button" @onclick="() => RemoveLogo(false)">Entfernen</button>}
                </div>
            </div>
            <p class="muted small">PNG, JPG oder WebP; je Logo höchstens 750 KB. Die Logos werden verschlüsselt in der Schuldatei gespeichert.</p>
            <p class="muted">Schuljahr: <strong>@f.Term</strong>. Für ein neues Halbjahr eine neue Schuldatei erstellen.</p>
            <div class="actions"><button class="btn primary" type="submit">Übernehmen</button></div>
        </form>
    }
</AdminFrame>

@code {
    private SchoolInfo _info = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (File is { } f)
            _info = new SchoolInfo
            {
                Name = f.School.Name, AddressLine1 = f.School.AddressLine1, AddressLine2 = f.School.AddressLine2,
                Town = f.School.Town, Phone = f.School.Phone, LeftLogoDataUrl = f.School.LeftLogoDataUrl,
                RightLogoDataUrl = f.School.RightLogoDataUrl,
            };
    }

    private void Save() => Change(f =>
    {
        if (string.IsNullOrWhiteSpace(_info.Name)) throw new MasterDataException("Bitte den Namen der Schule angeben.");
        var updated = new SchoolInfo
        {
            Name = _info.Name.Trim(), AddressLine1 = _info.AddressLine1.Trim(), AddressLine2 = _info.AddressLine2.Trim(),
            Town = _info.Town.Trim(), Phone = _info.Phone.Trim(), LeftLogoDataUrl = _info.LeftLogoDataUrl,
            RightLogoDataUrl = _info.RightLogoDataUrl,
        };
        var changes = SchoolChanges(f.School, updated);
        if (changes.Count == 0) return;
        f.School = updated;
        f.Audit.Add(new AuditEntry(DateTimeOffset.UtcNow, "Schulangaben geändert", string.Join(" · ", changes)));
    }, "Angaben übernommen. Zum Sichern „Speichern“ wählen.");

    private static List<string> SchoolChanges(SchoolInfo old, SchoolInfo updated)
    {
        var changes = new List<string>();
        Add("Name", old.Name, updated.Name);
        Add("Anschrift 1", old.AddressLine1, updated.AddressLine1);
        Add("Anschrift 2", old.AddressLine2, updated.AddressLine2);
        Add("Ort", old.Town, updated.Town);
        Add("Telefon", old.Phone, updated.Phone);
        if (old.LeftLogoDataUrl != updated.LeftLogoDataUrl) changes.Add("Logo links geändert");
        if (old.RightLogoDataUrl != updated.RightLogoDataUrl) changes.Add("Logo rechts geändert");
        return changes;

        void Add(string label, string before, string after)
        {
            if (before != after) changes.Add($"{label}: {Display(before)} → {Display(after)}");
        }
        static string Display(string value) => value.Length == 0 ? "(leer)" : value;
    }

    private async Task SetLogoAsync(InputFileChangeEventArgs e, bool left)
    {
        var file = e.File;
        if (file.Size > 750 * 1024) throw new MasterDataException("Das Logo darf höchstens 750 KB groß sein.");
        if (file.ContentType is not ("image/png" or "image/jpeg" or "image/webp"))
            throw new MasterDataException("Bitte PNG, JPG oder WebP wählen.");
        await using var stream = file.OpenReadStream(750 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var dataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
        if (left) _info.LeftLogoDataUrl = dataUrl; else _info.RightLogoDataUrl = dataUrl;
    }

    private void RemoveLogo(bool left)
    {
        if (left) _info.LeftLogoDataUrl = ""; else _info.RightLogoDataUrl = "";
    }
}
